# =========================
# Core AI configuration
# =========================
# Provider options:
# gemini -> Google Gemini via google-genai SDK
# openai -> OpenAI Responses API
AI_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium

# =========================
# News provider configuration
# Use "newsdata" for NewsData.io, "newsapi" for NewsAPI, or "gdelt" for the fallback source.
# NewsData.io free plan returns delayed news and the latest endpoint focuses on the last 48 hours.
# =========================
NEWS_PROVIDER=newsdata
NEWSDATA_API_KEY=your_newsdata_api_key_here
NEWSDATA_COUNTRY=
NEWSDATA_CATEGORIES=business,politics
NEWSDATA_QUERY=
NEWSDATA_QUERY_IN_TITLE=
NEWS_API_KEY=your_newsapi_key_here
NEWS_LANGUAGE=en
FETCH_WINDOW_HOURS=72
MAX_ARTICLES_TO_FETCH=40
TOP_ARTICLES_TO_KEEP=2

# =========================
# Posting behavior
# auto     -> try LinkedIn API first, then Selenium
# api      -> force LinkedIn API only
# selenium -> force browser automation only
# =========================
POSTING_MODE=auto
NORMAL_POST_INTERVAL_DAYS=3
MAJOR_EVENT_WINDOW_HOURS=24
CHECK_INTERVAL_MINUTES=60
REQUEST_TIMEOUT_SECONDS=25

# =========================
# LinkedIn API setup
# Needed only if you want API posting.
# Get these from your LinkedIn developer app.
# =========================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
LINKEDIN_PERSON_URN=

# =========================
# Selenium fallback setup
# Needed if you want browser automation posting.
# Headless is off by default because LinkedIn often behaves better
# in a visible browser session.
# =========================
LINKEDIN_EMAIL=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here
LINKEDIN_HEADLESS=false
CHROME_BINARY_PATH=
